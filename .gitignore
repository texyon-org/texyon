# Build files
/cross
/docs/book/*
/target

# Tests
/tests/plain.fmt
/tests/00*00-latex-*.fmt
/tests/*-plain-*.fmt
/tests/xenia/paper.pdf
/*.expected
/*.observed
/tests/engine_rust/goldens/*.observed

# Tectonic bundles
*.ttb

# Misc
*.ignore
# Corpus harness temp files
crates/engine_xetex/tests/corpus/goldens/*.tmp

# WebAssembly build
# The toolchain and the C libraries it compiles are fetched by
# tools/wasm/fetch-deps.sh; the support pack and the module are built artifacts.
/tools/wasm/wasi-sdk-*
/tools/wasm/*.tar.gz
/tools/wasm/vendor/
/client/public/tectonic/files/
/client/public/tectonic/manifest.json
/client/public/tectonic/*.wasm
node_modules/
/js/dist/
/client/dist/
*.tsbuildinfo

# Scratch documents for trying the editor out. sample.tex is the one that ships
# and seeds the support pack; anything else here is the author's own.
/client/sample*.tex
!/client/sample.tex
