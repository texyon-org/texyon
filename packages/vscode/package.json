{
  "name": "texyon",
  "displayName": "TeXyoN Live Preview",
  "description": "Live LaTeX preview that updates as you type, backed by a resident TeXyoN engine.",
  "version": "0.3.0",
  "publisher": "texyon",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/texyon-org/texyon",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/texyon-org/texyon/tree/master/packages/vscode#readme",
  "bugs": {
    "url": "https://github.com/texyon-org/texyon/issues"
  },
  "galleryBanner": {
    "color": "#0D1530",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "latex",
    "tex",
    "xetex",
    "preview",
    "synctex"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "texyon.start",
        "title": "Start Live Preview",
        "category": "TeXyoN",
        "icon": "$(open-preview)"
      },
      {
        "command": "texyon.stop",
        "title": "Stop Live Preview",
        "category": "TeXyoN"
      },
      {
        "command": "texyon.cancel",
        "title": "Cancel In-Flight Preview",
        "category": "TeXyoN"
      },
      {
        "command": "texyon.forwardSearch",
        "title": "Show Cursor in Live Preview",
        "category": "TeXyoN",
        "icon": "$(go-to-file)"
      },
      {
        "command": "texyon.exportPdf",
        "title": "Export PDF",
        "category": "TeXyoN",
        "icon": "$(export)"
      },
      {
        "command": "texyon.zoomIn",
        "title": "Zoom In",
        "category": "TeXyoN",
        "icon": "$(zoom-in)"
      },
      {
        "command": "texyon.zoomOut",
        "title": "Zoom Out",
        "category": "TeXyoN",
        "icon": "$(zoom-out)"
      },
      {
        "command": "texyon.zoomFit",
        "title": "Fit Width",
        "category": "TeXyoN",
        "icon": "$(screen-normal)"
      }
    ],
    "configuration": {
      "title": "TeXyoN Live Preview",
      "properties": {
        "texyon.executable": {
          "type": "string",
          "default": "",
          "description": "Path to a TeXyoN executable built with the preview-mupdf feature. Leave empty to use the one bundled with the extension."
        },
        "texyon.format": {
          "type": "string",
          "default": "latex",
          "description": "XeTeX format to preview with. It is built on first use."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "texyon.start",
          "when": "resourceExtname == .tex && !texyon.previewOpen",
          "group": "navigation"
        },
        {
          "command": "texyon.forwardSearch",
          "when": "resourceExtname == .tex && texyon.previewOpen",
          "group": "navigation"
        },
        {
          "command": "texyon.zoomOut",
          "when": "activeWebviewPanelId == 'texyon'",
          "group": "navigation@1"
        },
        {
          "command": "texyon.zoomFit",
          "when": "activeWebviewPanelId == 'texyon'",
          "group": "navigation@2"
        },
        {
          "command": "texyon.zoomIn",
          "when": "activeWebviewPanelId == 'texyon'",
          "group": "navigation@3"
        },
        {
          "command": "texyon.exportPdf",
          "when": "activeWebviewPanelId == 'texyon'",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "texyon.zoomIn",
          "when": "activeWebviewPanelId == 'texyon'"
        },
        {
          "command": "texyon.zoomOut",
          "when": "activeWebviewPanelId == 'texyon'"
        },
        {
          "command": "texyon.zoomFit",
          "when": "activeWebviewPanelId == 'texyon'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "texyon.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeWebviewPanelId == 'texyon'"
      },
      {
        "command": "texyon.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeWebviewPanelId == 'texyon'"
      },
      {
        "command": "texyon.zoomFit",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeWebviewPanelId == 'texyon'"
      },
      {
        "command": "texyon.forwardSearch",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "editorTextFocus && texyon.previewOpen"
      }
    ]
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3"
  }
}
