# Static analysis for the Tectonic editor server.
#
# Level 10 is PHPStan's maximum: every value's type is known, and an implicit
# `mixed` is an error rather than a shrug. There is deliberately no baseline —
# a baseline is a list of things nobody intends to fix, and starting one on the
# first commit means the level is a decoration.
#
# The rule this codebase follows to make that affordable is architectural rather
# than a matter of annotations: Eloquent models never leave `App\Persistence`.
# Everything above it is given readonly DTOs whose types PHPStan can actually
# see, so magic properties, dynamic `find()` returns and query-builder
# reflection are confined to one directory instead of running through the
# application.

# Larastan and the two rule sets are registered by phpstan/extension-installer;
# including them here as well would load each twice.

parameters:
    level: 10

    paths:
        - app
        - config
        - database
        - routes
        - tests

    # Laravel writes a compiled container and cached views under here; they are
    # generated artifacts, not source.
    excludePaths:
        - bootstrap/cache
        - storage

    # Catches `$user->emal` — a typo that is otherwise a silent null.
    checkModelProperties: true

    # `env()` outside config is read before the framework caches configuration,
    # so it returns null in production and nowhere else. This makes that a
    # compile-time error instead of a deployment-day one.
    noEnvCallsOutsideOfConfig: true

    # An uninitialized typed property is a TypeError waiting for the first
    # request that reads it.
    checkUninitializedProperties: true

    # A method whose declared return type is wider than what it can return
    # forces every caller to handle cases that cannot happen.
    checkTooWideReturnTypesInProtectedAndPublicMethods: true

    # A callable with no declared signature is an untyped hole that level 10
    # would otherwise accept.
    checkMissingCallableSignature: true

    strictRules:
        # The one rule turned off, and it is turned off rather than suppressed
        # line by line so that the reason is in one place.
        #
        # Eloquent's query builder forwards to methods the framework declares
        # static, so `Project::query()->orderBy(...)` is an instance call to a
        # static method by design. The rule exists to catch that pattern where
        # it is a mistake; here it is the documented API of the ORM, and every
        # repository method would otherwise carry an ignore.
        dynamicCallOnStaticMethod: false
