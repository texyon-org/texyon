# The image is built from three trees — js/, client/, server/ — and nothing
# else. Everything below the first three lines is carving state, secrets and
# build outputs back out of those trees; last match wins.
*
!js
!client
!server

# Dependencies and build outputs are produced inside the image, against the
# lockfiles. The one exception is client/public/tectonic — the engine module
# and support pack are built outside (tools/wasm/) and enter through the
# context, so they are deliberately not listed here.
js/node_modules
js/dist
client/node_modules
client/dist
client/tsconfig.tsbuildinfo

server/vendor
server/node_modules
server/bootstrap/cache/*
!server/bootstrap/cache/.gitignore

# State, not source.
server/storage/framework/cache/*
server/storage/framework/sessions/*
server/storage/framework/views/*
server/storage/framework/testing
server/storage/logs/*
server/storage/app/blobs
server/database/*.sqlite

# Secrets and local-only things.
server/.env
server/.env.*
!server/.env.example
server/.phpunit.cache
server/phpstan.neon
server/tests
