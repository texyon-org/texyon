{
  "name": "texyon",
  "displayName": "TeXyoN Live Preview",
  "description": "Live LaTeX preview that updates as you type, backed by a resident TeXyoN engine.",
  "version": "0.1.0",
  "publisher": "texyon",
  "license": "AGPL-3.0-or-later",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/texyon-org/texyon",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/texyon-org/texyon/tree/master/editors/vscode#readme",
  "bugs": {
    "url": "https://github.com/texyon-org/texyon/issues"
  },
  "galleryBanner": {
    "color": "#0D1530",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "latex",
    "tex",
    "xetex",
    "preview",
    "synctex"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "texyon.start",
        "title": "TeXyoN: Start Live Preview"
      },
      {
        "command": "texyon.stop",
        "title": "TeXyoN: Stop Live Preview"
      },
      {
        "command": "texyon.cancel",
        "title": "TeXyoN: Cancel In-Flight Preview"
      },
      {
        "command": "texyon.forwardSearch",
        "title": "TeXyoN: Show Cursor in Live Preview"
      },
      {
        "command": "texyon.exportPdf",
        "title": "TeXyoN: Export PDF"
      }
    ],
    "configuration": {
      "title": "TeXyoN Live Preview",
      "properties": {
        "texyon.executable": {
          "type": "string",
          "default": "",
          "description": "Path to a TeXyoN executable built with the preview-mupdf feature. Leave empty to use the one bundled with the extension."
        },
        "texyon.format": {
          "type": "string",
          "default": "latex",
          "description": "XeTeX format to preview with. It is built on first use."
        }
      }
    }
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3"
  }
}
