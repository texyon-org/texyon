{
  "name": "texyon",
  "displayName": "TeXyon Live Preview",
  "description": "SVG live preview backed by a resident TeXyon engine process.",
  "version": "0.0.1",
  "publisher": "texyon",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "texyon.start",
        "title": "TeXyon: Start Live Preview"
      },
      {
        "command": "texyon.stop",
        "title": "TeXyon: Stop Live Preview"
      },
      {
        "command": "texyon.cancel",
        "title": "TeXyon: Cancel In-Flight Preview"
      },
      {
        "command": "texyon.forwardSearch",
        "title": "TeXyon: Show Cursor in Live Preview"
      }
    ],
    "configuration": {
      "title": "TeXyon Live Preview",
      "properties": {
        "texyon.executable": {
          "type": "string",
          "default": "texyon",
          "description": "Path to a TeXyon executable built with the preview-mupdf feature."
        },
        "texyon.format": {
          "type": "string",
          "default": "latex",
          "description": "Cached XeTeX format to use for preview."
        }
      }
    }
  }
}
